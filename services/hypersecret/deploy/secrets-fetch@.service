# Oneshot fetcher: populates /run/secrets/<instance>.env for services that
# consume secrets via EnvironmentFile= (systemd-native pattern; the app needs
# no wrapper at all). Instance name = your service name.
#
#   systemctl enable secrets-fetch@myapp
#   # then in myapp.service:
#   #   Wants=secrets-fetch@myapp.service
#   #   After=secrets-fetch@myapp.service
#   #   EnvironmentFile=/run/secrets/myapp.env

[Unit]
Description=Fetch HyperSecret secrets for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Runs as root by design: no User= / sandboxing directives. This oneshot's whole
# job is to read the deploy-time identity + KEK from /etc/hypersecret/%i.env
# (root-owned, 0600) and write the fetched plaintext to /run/secrets/%i.env for
# the consuming unit's EnvironmentFile=. Both paths are root-only; dropping
# privileges here would just move the trust boundary without reducing it. The
# long-running app that consumes the result is the unit to harden (User=,
# ProtectSystem=, etc.) — not this short-lived privileged fetch.
# Identity + KEK for this host's namespace, distributed at deploy time.
EnvironmentFile=/etc/hypersecret/%i.env
RuntimeDirectory=secrets
RuntimeDirectoryMode=0700
ExecStart=/opt/hyperdjango/.venv/bin/python -m services.hypersecret.secrets_run --output /run/secrets/%i.env
