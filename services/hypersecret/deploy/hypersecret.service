# HyperSecret server unit. The server holds no key material, so this unit
# needs no KEK files — only its database URL and framework secrets.
#
#   cp hypersecret.service /etc/systemd/system/
#   systemctl enable --now hypersecret

[Unit]
Description=HyperSecret secret manager
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=hypersecret
Group=hypersecret
WorkingDirectory=/opt/hyperdjango
Environment=HYPER_DEBUG=0
Environment=HYPER_DATABASE_URL=postgres://hypersecret@localhost/hypersecret
# Real deployments: put HYPER_SECRET_KEY / HYPER_ADMIN_SECRET /
# HYPER_SESSION_SIGNING_KEY (the framework's stable token-signing key — the app
# refuses to start without it) in a root-owned 0600 environment file, not
# inline here.
EnvironmentFile=/etc/hypersecret/server.env
ExecStart=/opt/hyperdjango/.venv/bin/hyper start --app services.hypersecret.app:app --port 8960
Restart=on-failure
RestartSec=2

# Hardening — the server is ciphertext-only; keep its blast radius small too.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/hyperdjango/logs

[Install]
WantedBy=multi-user.target
