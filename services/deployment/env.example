# HyperDjango Production Environment
# Copy to .env and edit values before deploying.

# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-generate-a-64-char-hex-string
DATABASE_URL=postgres://myuser:mypassword@localhost:5432/mydb

# RECOMMENDED
DEBUG=0
ALLOWED_ORIGINS=https://myapp.com,https://api.myapp.com

# OPTIONAL — defaults are sensible for most deployments
# HYPER_POOL_SIZE=0              # 0 = auto (CPU cores x 2)
# HYPER_CONNECT_TIMEOUT=10000    # ms
# HYPER_QUERY_TIMEOUT=30000      # ms
# HYPER_THREAD_POOL_SIZE=24      # HTTP server worker threads
# SESSION_SECRET=same-as-SECRET_KEY-if-not-set
